# ==========================================
# StockSense ERP Environment Configuration
# ==========================================

# Server Port and Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Example Atlas: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/stocksense
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/stocksense?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/stocksense?retryWrites=true&w=majority

# JWT Authentication Secret and Expiration
# Example Secret: your-strong-random-jwt-secret-key
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_EXPIRE=7d

# Default Multi-Tenant / Organization ID (Optional Mongo ObjectId)
# Example: 65f000000000000000000001
DEFAULT_COMPANY_ID=your_company_object_id

# Frontend Client Origin (CORS configuration)
# Example: http://localhost:5173
CLIENT_URL=http://localhost:5173

# Email SMTP Notification Configuration (Optional)
# Example: smtp.mailtrap.io or smtp.gmail.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email_username
EMAIL_PASS=your_email_password
