{
  "name": "stocksense",
  "version": "1.0.0",
  "description": "StockSense - Real-Time Smart Inventory & Warehouse Management System",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/server.js",
    "client:dev": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "start": "node server/server.js",
    "client:build": "npm --prefix client run build"
  },
  "keywords": [
    "inventory",
    "warehouse",
    "stock-management",
    "odoo",
    "erp",
    "react",
    "nodejs"
  ],
  "author": "StockSense Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}
